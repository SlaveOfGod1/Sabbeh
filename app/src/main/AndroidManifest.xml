<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sabbeh">

    <!-- Vibrate when a round completes (toggleable in Settings, same as Expo Haptics) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Sabbeh"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:allowBackup="true"
        android:theme="@style/Theme.Sabbeh">
        <activity
            android:name="com.sabbeh.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Alternate launcher icons, switched from Settings > App icon.
             MainActivity itself carries the Default (green) icon. -->
        <activity-alias
            android:name="com.sabbeh.IconGreenTransparent"
            android:targetActivity="com.sabbeh.MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Sabbeh"
            android:icon="@drawable/icon_day_fg"
            android:roundIcon="@drawable/icon_day_fg">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.sabbeh.IconWhiteTransparent"
            android:targetActivity="com.sabbeh.MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Sabbeh"
            android:icon="@drawable/icon_mono_fg"
            android:roundIcon="@drawable/icon_mono_fg">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.sabbeh.IconWhiteOnBlack"
            android:targetActivity="com.sabbeh.MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Sabbeh"
            android:icon="@mipmap/ic_launcher_white_black"
            android:roundIcon="@mipmap/ic_launcher_white_black">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.sabbeh.IconBlackTransparent"
            android:targetActivity="com.sabbeh.MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Sabbeh"
            android:icon="@drawable/icon_mono_black"
            android:roundIcon="@drawable/icon_mono_black">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
